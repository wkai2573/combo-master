    },
    {
      "name": "追擊+X",
      "group": "動作",
      "desc": "追擊階段翻開 X 張牌做為追擊判定。"
    },
    {
      "name": "追擊判定",
      "group": "名詞",
      "desc": "追擊階段翻的卡，會判定成功或失敗：不在範圍內就成功，該卡成為追擊卡；在範圍內就失敗，該卡加入手中。"
    },
    {
      "name": "範圍內",
      "group": "名詞",
      "desc": "指能在反擊步驟打出的招式限制：雙方戰鬥區最後一張招式的連擊值之間（含）。"
    },
    {
      "name": "總攻擊",
      "group": "名詞",
      "desc": "己方招式卡與追擊卡攻擊力的總和。"
    },
    {
      "name": "總防禦",
      "group": "名詞",
      "desc": "己方招式卡防禦力的總和。"
    },
    {
      "name": "覺醒",
      "group": "名詞",
      "desc": "我方經驗區的卡片數 ≥ 角色的覺醒經驗時，視為覺醒狀態，獲得覺醒效果。"
    },
    {
      "name": "瞄準",
      "group": "角色技能",
      "desc": "追擊判定翻牌前，可先看牌組頂 1 張；不想用就放到牌組底，改用新的牌組頂判定。每回合限用 1 次。"
    },
    {
      "name": "數字",
      "group": "書寫規範",
      "desc": "寫在卡上的數字皆以阿拉伯數字表示（寫「1 張卡」，不寫「一張卡」）。"
    },
    {
      "name": "我方／對方／雙方",
      "group": "書寫規範",
      "desc": "效果中表示目標對象的用詞，統一用「我方」「對方」「雙方」，不寫「你」或「敵方」。"
    },
    {
      "name": "階段開始時／結束時",
