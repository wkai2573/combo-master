{
  "name": "combo-master-tcg",
  "private": true,
  "version": "0.37.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data": "tsx scripts/build-data.ts",
    "sim": "tsx scripts/simulate.ts",
    "presets": "tsx scripts/preset-report.ts",
    "table": "tsx scripts/sync-card-table.ts",
    "server:dev": "npx --yes wrangler@4 dev --local --config server/wrangler.toml",
    "server:db:local": "npx --yes wrangler@4 d1 execute combo-master-records --local --file server/schema.sql --config server/wrangler.toml",
    "server:db": "npx --yes wrangler@4 d1 execute combo-master-records --remote --file server/schema.sql --config server/wrangler.toml",
    "server:deploy": "npx --yes wrangler@4 deploy --config server/wrangler.toml"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "xlsx": "0.18.5"
  }
}
